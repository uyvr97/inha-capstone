# Server Configuration
PORT=3001
HOST=0.0.0.0

# PN532 I2C Configuration
# I2C bus number (usually 1 on Raspberry Pi)
I2C_BUS=1

# I2C address of PN532 (default: 0x24)
I2C_ADDRESS=0x24

# Timeouts (in milliseconds)
# Time to wait for PN532 to be ready
READY_TIMEOUT_MS=3000

# Time to wait for NFC tag
TAGGING_TIMEOUT_MS=10000

# Session timeout
SESSION_TIMEOUT_MS=30000

# Maximum retry attempts
MAX_RETRIES=3

# Receipt Base URL
# Base URL for receipt viewer (used to generate receipt URLs)
RECEIPT_BASE_URL=http://localhost:3000
